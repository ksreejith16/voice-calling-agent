{
  "name": "@india-voice/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS and Fastify foundation API for the India voice platform",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && concurrently -k -n compiler,server \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/src/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@clerk/backend": "3.18.1",
    "@india-voice/database": "0.1.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "livekit-server-sdk": "2.19.0",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  }
}
