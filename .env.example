# Copy to .env in the repository root. These passwords are LOCAL DEVELOPMENT ONLY.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
# Web runs on port 3000. No browser-visible secrets or NEXT_PUBLIC credentials.

# Separate roles: postgres bootstraps roles; voice_migrator owns DDL;
# voice_app is the restricted, non-owner runtime role with forced tenant RLS.
POSTGRES_ADMIN_PASSWORD=local_admin_only
POSTGRES_MIGRATOR_PASSWORD=local_migrator_only
POSTGRES_APP_PASSWORD=local_app_only
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=postgresql://voice_migrator:local_migrator_only@127.0.0.1:5432/voice_platform
DATABASE_URL=postgresql://voice_app:local_app_only@127.0.0.1:5432/voice_platform
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Separate disposable test database; integration tests reject other database names.
TEST_MIGRATION_DATABASE_URL=postgresql://voice_migrator:local_migrator_only@127.0.0.1:5432/voice_platform_test
TEST_DATABASE_URL=postgresql://voice_app:local_app_only@127.0.0.1:5432/voice_platform_test
# Test-only organization provisioning, never used by the API or normal migrations.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:local_admin_only@127.0.0.1:5432/voice_platform_test

# No login or tenant HTTP endpoints in this foundation. Disabled is the only
# implemented mode. Future OIDC must verify tokens AND organization membership.
AUTH_MODE=disabled
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_SESSION_SECRET=

# Later voice phase: server-only credentials. No provider account needed now.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Private recording storage and replaceable LLM: unimplemented provider adapters.
RECORDING_STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RECORDING_BUCKET=
RECORDING_KMS_KEY_ID=
RECORDING_SIGNED_URL_TTL_SECONDS=300
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Proposed defaults for future services; existing obligations use DB snapshots.
# Amounts are decimal integer PAISE. 30-second quantum requires even paise/minute.
BILLING_RATE_PAISE_PER_MINUTE=600
BILLING_QUANTUM_SECONDS=60
CALL_MAX_DURATION_SECONDS=300
CALL_TERMINATION_MARGIN_SECONDS=10

# Future voice instrumentation; target is NOT a measured result.
VOICE_LATENCY_P95_TARGET_MS=500
VOICE_LATENCY_PROFILE=
OTEL_SERVICE_NAME=india-voice-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
